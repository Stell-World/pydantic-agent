# Configuration des clés API pour KWAME AI
# Copiez ce fichier en .env et ajoutez vos vraies clés

# Groq API (pour Llama)
GROQ_API_KEY=votre_cle_groq_ici

# Google Gemini API (pour Gemini)
GOOGLE_API_KEY=votre_cle_google_ici

# Tavily Search API (pour la recherche web)
TAVILY_API_KEY=votre_cle_tavily_ici

# Weather API (pour la météo)
GETWEATHER_API_KEY=votre_cle_weather_ici

# Langfuse (optionnel, pour le monitoring)
LANGFUSE_SECRET_KEY=votre_secret_key_ici
LANGFUSE_PUBLIC_KEY=votre_public_key_ici
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Exemples de clés (remplacez par les vraies):
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=AIza...
# TAVILY_API_KEY=tvly-...
# GETWEATHER_API_KEY=...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_PUBLIC_KEY=pk-...
